<Window x:Class="CybersecurityBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyBrog - Cybersecurity Awareness" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF0A2342" CornerRadius="6" Padding="8">
            <TextBlock x:Name="HeaderText" Text="CYBERSECURITY AWARENESS BOT" Foreground="White" FontSize="18" FontWeight="Bold" />
        </Border>

        <ScrollViewer Grid.Row="1" Name="ChatScroll" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8">
            <StackPanel x:Name="ChatPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBox x:Name="InputBox" Width="600" Height="30" Margin="0,0,8,0" />
            <Button x:Name="SendButton" Content="Send" Width="80" Click="SendButton_Click" />
        </StackPanel>
    </Grid>
</Window>